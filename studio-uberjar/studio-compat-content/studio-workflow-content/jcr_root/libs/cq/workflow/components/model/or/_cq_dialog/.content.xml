                    <default jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/checkbox" text="Default Route" name="./metaData/default3" value="true" uncheckedValue="false" fieldDescription="Taken when no other branch rule holds."/><rule jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Rule" name="./metaData/rule3" fieldDescription="true, false or empty (always). Script rules are not evaluated by Sensible Studio and count as false."/>
                </items>
            </branch3>
<branch4 jcr:primaryType="nt:unstructured" jcr:title="Branch 4" sling:resourceType="granite/ui/components/coral/foundation/container" margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <default jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/checkbox" text="Default Route" name="./metaData/default4" value="true" uncheckedValue="false" fieldDescription="Taken when no other branch rule holds."/><rule jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Rule" name="./metaData/rule4" fieldDescription="true, false or empty (always). Script rules are not evaluated by Sensible Studio and count as false."/>
