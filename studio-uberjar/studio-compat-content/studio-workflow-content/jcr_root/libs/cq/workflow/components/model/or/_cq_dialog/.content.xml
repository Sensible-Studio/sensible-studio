                    <default jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/checkbox" text="Default Route" name="./metaData/default1" value="true" uncheckedValue="false" fieldDescription="Taken when no other branch rule holds."/><rule jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Rule" name="./metaData/rule1" fieldDescription="true, false or empty (always). Script rules are not evaluated by Sensible Studio and count as false."/>
                </items>
            </branch1>
<branch2 jcr:primaryType="nt:unstructured" jcr:title="Branch 2" sling:resourceType="granite/ui/components/coral/foundation/container" margin="{Boolean}true">
