<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="sling:OrderedFolder"
    jcr:title="Sync rules">
    <default
        jcr:primaryType="cq:RolloutConfig"
        jcr:title="Standard sync"
        jcr:description="When you synchronize: updates, creates and removes content, keeps the order of the source and points links (also to experience and content fragments) to the linked copy."
        cq:trigger="rollout">
        <contentUpdate jcr:primaryType="cq:LiveSyncAction"/>
        <contentCopy jcr:primaryType="cq:LiveSyncAction"/>
        <contentDelete jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdate jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateXF jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateCF jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateXFEmbedded jcr:primaryType="cq:LiveSyncAction"/>
        <orderChildren jcr:primaryType="cq:LiveSyncAction"/>
    </default>
    <pushonmodify
        jcr:primaryType="cq:RolloutConfig"
        jcr:title="Sync on change"
        jcr:description="Whenever a source page changes: the same synchronisation as the standard sync, for that page."
        cq:trigger="modification">
        <contentUpdate jcr:primaryType="cq:LiveSyncAction"/>
        <contentCopy jcr:primaryType="cq:LiveSyncAction"/>
        <contentDelete jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdate jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateXF jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateXFEmbedded jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateCF jcr:primaryType="cq:LiveSyncAction"/>
        <orderChildren jcr:primaryType="cq:LiveSyncAction"/>
    </pushonmodify>
    <versioned
        jcr:primaryType="cq:RolloutConfig"
        jcr:title="Standard sync with versions"
        jcr:description="Like the standard sync, but first saves each page of the linked copy as a version, so the sync can be undone from the page's versions."
        cq:trigger="rollout">
        <targetVersion jcr:primaryType="cq:LiveSyncAction"/>
        <contentUpdate jcr:primaryType="cq:LiveSyncAction"/>
        <contentCopy jcr:primaryType="cq:LiveSyncAction"/>
        <contentDelete jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdate jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateXF jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateCF jcr:primaryType="cq:LiveSyncAction"/>
        <referencesUpdateXFEmbedded jcr:primaryType="cq:LiveSyncAction"/>
        <orderChildren jcr:primaryType="cq:LiveSyncAction"/>
    </versioned>
    <activate
        jcr:primaryType="cq:RolloutConfig"
        jcr:title="Publish with the source"
        jcr:description="When a source page is published, publishes the page of the linked copy too (needs a publishing target)."
        cq:trigger="publish">
        <targetActivate jcr:primaryType="cq:LiveSyncAction"/>
    </activate>
    <deactivate
        jcr:primaryType="cq:RolloutConfig"
        jcr:title="Unpublish with the source"
        jcr:description="When a source page is unpublished, unpublishes the page of the linked copy too (needs a publishing target)."
        cq:trigger="deactivate">
        <targetDeactivate jcr:primaryType="cq:LiveSyncAction"/>
    </deactivate>
</jcr:root>
