<?xml version="1.0" encoding="UTF-8"?>
<!--
  The policy of a layout container (Sensible Studio's own): which components authors may add, which component an asset dropped
  into the container becomes, and the number of columns. Containers built on the layout grid (Core's Container) get
  these tabs before their own, as in AEM's template editor.
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Layout Container"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <allowedComponents
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Allowed Components"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <components
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="studio/granite/components/allowedcomponents"
                                name="./components"/>
                        </items>
                    </allowedComponents>
                    <defaultComponents
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Default Components"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <mappings
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="studio/granite/components/assetmappings"
                                name="./cq:authoring/assetToComponentMapping"/>
                        </items>
                    </defaultComponents>
                    <responsiveSettings
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Responsive Settings"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Columns"
                                fieldDescription="Number of columns of the layout grid (12 when empty)."
                                min="1"
                                max="24"
                                name="./columns"/>
                        </items>
                    </responsiveSettings>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
