<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured">
    <basic
        jcr:primaryType="nt:unstructured"
        jcr:title="Basic"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <title
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Title and Tags"
                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                        <items jcr:primaryType="nt:unstructured">
                            <title
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Title"
                                name="./jcr:title"
                                required="{Boolean}true"/>
                            <tags
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                                fieldLabel="Tags"
                                fieldDescription="Tags describe the page for search, navigation and content lists."
                                multiple="{Boolean}true"
                                name="./cq:tags"/>
                            <hideinnav
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                name="./hideInNav"
                                text="Hide in Navigation"
                                value="true"/>
                        </items>
                    </title>
                    <moretitles
                        jcr:primaryType="nt:unstructured"
                        jcr:title="More Titles and Description"
                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                        <items jcr:primaryType="nt:unstructured">
                            <pagetitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Page Title"
                                fieldDescription="Used in the browser title when set."
                                name="./pageTitle"/>
                            <navtitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Navigation Title"
                                fieldDescription="Used by navigation components when set."
                                name="./navTitle"/>
                            <subtitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Subtitle"
                                name="./subtitle"/>
                            <description
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                fieldLabel="Description"
                                name="./jcr:description"
                                rows="{Long}3"/>
                        </items>
                    </moretitles>
                    <onofftime
                        jcr:primaryType="nt:unstructured"
                        jcr:title="On/Off Time"
                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                        <items jcr:primaryType="nt:unstructured">
                            <ontime
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                fieldLabel="On Time"
                                fieldDescription="The page is published only from this moment."
                                name="./onTime"
                                type="datetime"/>
                            <offtime
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                fieldLabel="Off Time"
                                fieldDescription="The page is no longer published from this moment."
                                name="./offTime"
                                type="datetime"/>
                        </items>
                    </onofftime>
                    <vanityurl
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Vanity URL"
                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                        <items jcr:primaryType="nt:unstructured">
                            <vanitypath
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Vanity URL"
                                fieldDescription="Short paths that also open this page, e.g. /skiing.">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    name="./sling:vanityPath"/>
                            </vanitypath>
                            <redirect
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                name="./sling:redirect"
                                text="Redirect Vanity URL"
                                value="{Boolean}true"/>
                        </items>
                    </vanityurl>
                </items>
            </column>
        </items>
    </basic>
    <advanced
        jcr:primaryType="nt:unstructured"
        jcr:title="Advanced"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <settings
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Settings"
                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                        <items jcr:primaryType="nt:unstructured">
                            <language
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                emptyOption="{Boolean}true"
                                fieldLabel="Language"
                                name="./jcr:language">
                                <datasource
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="studio/granite/datasources/languages"/>
                            </language>
                            <languageroot
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                fieldDescription="The page starts a language branch of the site (en, fr, …); language copies and translations are made below it."
                                name="./cq:isLanguageRoot"
                                text="Language Root"
                                value="true"/>
                            <redirect
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/coral/common/form/pagefield"
                                fieldLabel="Redirect"
                                fieldDescription="Visitors of this page are sent to the selected page or URL."
                                name="./cq:redirectTarget"
                                rootPath="/content"/>
                            <redirectpermanent
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                fieldDescription="Send the redirect as permanent (301) instead of temporary (302)."
                                name="./cq:redirectPermanent"
                                text="Permanent Redirect"
                                value="true"/>
                            <alias
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Alias"
                                fieldDescription="Alternative name of this page in URLs (sling:alias)."
                                name="./sling:alias"/>
                        </items>
                    </settings>
                    <configuration
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Configuration"
                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                        <items jcr:primaryType="nt:unstructured">
                            <conf
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="studio/granite/components/confpath"
                                fieldLabel="Cloud Configuration"
                                fieldDescription="The configuration (templates, policies, settings under /conf) of this page and the pages below it."
                                name="./cq:conf"
                                rootPath="/conf"/>
                        </items>
                    </configuration>
                    <templates
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Templates Settings"
                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                        <items jcr:primaryType="nt:unstructured">
                            <allowedtemplates
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Allowed Templates"
                                fieldDescription="Templates (or patterns) allowed for child pages, e.g. /conf/wknd/settings/wcm/templates/.*">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    name="./cq:allowedTemplates"/>
                            </allowedtemplates>
                        </items>
                    </templates>
                    <seo
                        jcr:primaryType="nt:unstructured"
                        jcr:title="SEO"
                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                        <items jcr:primaryType="nt:unstructured">
                            <canonicalurl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/coral/common/form/pagefield"
                                fieldLabel="Canonical Url"
                                fieldDescription="The page or URL search engines should index instead of this one."
                                name="./cq:canonicalUrl"
                                rootPath="/content"/>
                            <robotstags
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Robots Tags"
                                fieldDescription="Instructions for search engines, rendered as the robots meta tag of the page."
                                multiple="{Boolean}true"
                                name="./cq:robotsTags">
                                <items jcr:primaryType="nt:unstructured">
                                    <index jcr:primaryType="nt:unstructured" text="index" value="index"/>
                                    <noindex jcr:primaryType="nt:unstructured" text="noindex" value="noindex"/>
                                    <follow jcr:primaryType="nt:unstructured" text="follow" value="follow"/>
                                    <nofollow jcr:primaryType="nt:unstructured" text="nofollow" value="nofollow"/>
                                    <noarchive jcr:primaryType="nt:unstructured" text="noarchive" value="noarchive"/>
                                    <nosnippet jcr:primaryType="nt:unstructured" text="nosnippet" value="nosnippet"/>
                                    <noimageindex jcr:primaryType="nt:unstructured" text="noimageindex" value="noimageindex"/>
                                    <notranslate jcr:primaryType="nt:unstructured" text="notranslate" value="notranslate"/>
                                </items>
                            </robotstags>
                            <sitemaproot
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                fieldDescription="Generate a sitemap for this page and the pages below it."
                                name="./sling:sitemapRoot"
                                text="Generate Sitemap"
                                value="true"/>
                            <robotstxt
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                fieldLabel="robots.txt"
                                fieldDescription="On the site's top page: what /robots.txt answers. Empty: everything allowed, with a Sitemap line for each sitemap of the site."
                                name="./robotsTxt"
                                rows="{Long}5"/>
                        </items>
                    </seo>
                </items>
            </column>
        </items>
    </advanced>
    <pwa
        jcr:primaryType="nt:unstructured"
        jcr:title="Progressive Web App"
        sling:resourceType="granite/ui/components/coral/foundation/container"
        granite:hide="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <note
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/text"
                text="Progressive Web App settings are not available in Sensible Studio."/>
        </items>
    </pwa>
</jcr:root>
